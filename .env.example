# API
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_PORT=8080
DATABASE_URL=postgres://segen:segen@localhost:5432/segen?sslmode=disable
REDIS_URL=redis://localhost:6379

# AWS video pipeline (CDK SegenVideo stack)
AWS_REGION=us-east-1
S3_MASTERS_BUCKET=segen-masters-dev
S3_HLS_BUCKET=segen-hls-dev
MEDIACONVERT_ROLE_ARN=
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=

# AWS Cognito — existing pool (us-east-2 / US East Ohio)
COGNITO_USER_POOL_ID=us-east-2_DzYpvvqdN
COGNITO_ISSUER=https://cognito-idp.us-east-2.amazonaws.com/us-east-2_DzYpvvqdN
# App client "My web app" (Cognito → User pool → App integration → App clients)
COGNITO_WEB_CLIENT_ID=1fifo3bclseh2uqr0vkbf8e7pt
# Only if the app client was created WITH a secret (confidential client):
COGNITO_WEB_CLIENT_SECRET=
# Hosted UI / OAuth endpoints (Cognito → App integration → Domain)
COGNITO_DOMAIN=https://us-east-2dzypvvqdn.auth.us-east-2.amazoncognito.com

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-only-secret-change-me

# Browser-side mirrors (must equal the server values above)
NEXT_PUBLIC_COGNITO_ISSUER=https://cognito-idp.us-east-2.amazonaws.com/us-east-2_DzYpvvqdN
NEXT_PUBLIC_COGNITO_CLIENT_ID=1fifo3bclseh2uqr0vkbf8e7pt
NEXT_PUBLIC_COGNITO_DOMAIN=https://us-east-2dzypvvqdn.auth.us-east-2.amazoncognito.com
# Leave 'false': auth flips to real Cognito automatically once the client id is set.
NEXT_PUBLIC_USE_MOCK_AUTH=false
# 'false' => web calls the real Go API at NEXT_PUBLIC_API_URL (not mock data).
NEXT_PUBLIC_USE_MOCK=false

# Analytics / Billing (later)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
STRIPE_SECRET_KEY=


